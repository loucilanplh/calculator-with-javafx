<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="rootPane" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="calculator.Controller.CalculatorController">
    <VBox styleClass="main-container">
        <!-- Header -->
        <HBox styleClass="header">
            <Button text="☰" styleClass="icon-btn" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Scientific Calculator" styleClass="header-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="themeToggleBtn" text="☀️" onAction="#toggleTheme" styleClass="icon-btn" />
            <Button text="🕘" onAction="#showHistory" styleClass="icon-btn" />
        </HBox>

        <!-- Display -->
        <VBox styleClass="display-outer-container">
            <VBox styleClass="display-container" spacing="10">
                <Label fx:id="historyDisplay" styleClass="history-display" />
                <TextField fx:id="mainDisplay" styleClass="main-display" editable="false" />
            </VBox>
        </VBox>

        <!-- Keypad -->
        <VBox styleClass="keypad-container" VBox.vgrow="ALWAYS">
            <GridPane styleClass="keypad" alignment="CENTER">
                <!-- Row 0: Scientific functions -->
                <Button text="2nd" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="func-btn" />
                <Button text="deg" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="func-btn" />
                <Button text="sin" onAction="#handleAction" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="func-btn" />
                <Button text="cos" onAction="#handleAction" GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="func-btn" />
                <Button text="tan" onAction="#handleAction" GridPane.columnIndex="4" GridPane.rowIndex="0" styleClass="func-btn" />

                <!-- Row 1: Power and logs -->
                <Button text="xⁿ" onAction="#handleAction" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="func-btn" />
                <Button text="lg" onAction="#handleAction" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="func-btn" />
                <Button text="ln" onAction="#handleAction" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="func-btn" />
                <Button text="(" onAction="#handleAction" GridPane.columnIndex="3" GridPane.rowIndex="1" styleClass="func-btn" />
                <Button text=")" onAction="#handleAction" GridPane.columnIndex="4" GridPane.rowIndex="1" styleClass="func-btn" />

                <!-- Row 2: Basic ops top -->
                <Button text="AC" onAction="#handleClear" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="clear-btn" />
                <Button text="⌫" onAction="#handleBackspace" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="num-btn" />
                <Button text="\%" onAction="#handleAction" GridPane.columnIndex="2" GridPane.rowIndex="2" styleClass="op-btn" />
                <Button text="÷" onAction="#handleAction" GridPane.columnIndex="3" GridPane.rowIndex="2" styleClass="op-btn" />
                <Button text="√" onAction="#handleAction" GridPane.columnIndex="4" GridPane.rowIndex="2" styleClass="op-btn" />

                <!-- Row 3: 7-9 -->
                <Button text="7" onAction="#handleAction" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="num-btn" />
                <Button text="8" onAction="#handleAction" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="num-btn" />
                <Button text="9" onAction="#handleAction" GridPane.columnIndex="2" GridPane.rowIndex="3" styleClass="num-btn" />
                <Button text="x" onAction="#handleAction" GridPane.columnIndex="3" GridPane.rowIndex="3" styleClass="op-btn" />
                <Button text="x!" onAction="#handleAction" GridPane.columnIndex="4" GridPane.rowIndex="3" styleClass="op-btn" />

                <!-- Row 4: 4-6 -->
                <Button text="4" onAction="#handleAction" GridPane.columnIndex="0" GridPane.rowIndex="4" styleClass="num-btn" />
                <Button text="5" onAction="#handleAction" GridPane.columnIndex="1" GridPane.rowIndex="4" styleClass="num-btn" />
                <Button text="6" onAction="#handleAction" GridPane.columnIndex="2" GridPane.rowIndex="4" styleClass="num-btn" />
                <Button text="-" onAction="#handleAction" GridPane.columnIndex="3" GridPane.rowIndex="4" styleClass="op-btn" />
                <Button text="1/x" onAction="#handleAction" GridPane.columnIndex="4" GridPane.rowIndex="4" styleClass="op-btn" />

                <!-- Row 5: 1-3 -->
                <Button text="1" onAction="#handleAction" GridPane.columnIndex="0" GridPane.rowIndex="5" styleClass="num-btn" />
                <Button text="2" onAction="#handleAction" GridPane.columnIndex="1" GridPane.rowIndex="5" styleClass="num-btn" />
                <Button text="3" onAction="#handleAction" GridPane.columnIndex="2" GridPane.rowIndex="5" styleClass="num-btn" />
                <Button text="+" onAction="#handleAction" GridPane.columnIndex="3" GridPane.rowIndex="5" styleClass="op-btn" />
                <Button text="π" onAction="#handleAction" GridPane.columnIndex="4" GridPane.rowIndex="5" styleClass="op-btn" />

                <!-- Row 6: e, 0, ., = -->
                <Button text="e" onAction="#handleAction" GridPane.columnIndex="0" GridPane.rowIndex="6" styleClass="num-btn" />
                <Button text="0" onAction="#handleAction" GridPane.columnIndex="1" GridPane.rowIndex="6" styleClass="num-btn" />
                <Button text="." onAction="#handleAction" GridPane.columnIndex="2" GridPane.rowIndex="6" styleClass="num-btn" />
                <Button text="=" onAction="#handleCalculate" GridPane.columnIndex="3" GridPane.rowIndex="6" GridPane.columnSpan="2" styleClass="eq-btn" maxWidth="Infinity" />
            </GridPane>
        </VBox>

        <!-- Bottom Bar -->
        <HBox styleClass="bottom-bar" spacing="10">
             <VBox alignment="CENTER_LEFT">
                <Label text="Active Mode" styleClass="active-mode-label" />
                <Label text="Radiant Trigonometry" styleClass="active-mode-value" />
             </VBox>
        </HBox>
    </VBox>
    
    <!-- Floating Action Button -->
    <Button text="🔍" styleClass="fab" StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin>
            <Insets bottom="80" right="25" />
        </StackPane.margin>
    </Button>
</StackPane>
